{
  "name": "canalschallenge",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:up": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate up -m src/db/migrations",
    "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate down -m src/db/migrations",
    "migrate:create": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate create -m src/db/migrations",
    "seed": "node --env-file=.env --import tsx src/db/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinis16/CanalsChallenge.git"
  },
  "author": "Santiago Sinisterra Arias",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Sinis16/CanalsChallenge/issues"
  },
  "homepage": "https://github.com/Sinis16/CanalsChallenge#readme",
  "description": "",
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
